---
interface Props {
	variant?: 'default' | 'destructive' | 'success' | 'warning' | 'info';
	title?: string;
	class?: string;
}
const {
	variant = 'default',
	title,
	class: className = '',
	...attrs
} = Astro.props;

const variants = {
	default: 'bg-[var(--accent)] text-[var(--accent-foreground)] border-[var(--border)]',
	destructive: 'bg-[color-mix(in_oklch,var(--destructive)_12%,var(--background))] text-[var(--destructive)] border-[color-mix(in_oklch,var(--destructive)_30%,transparent)]',
	success: 'bg-[color-mix(in_oklch,var(--color-green)_12%,var(--background))] text-[var(--color-green)] border-[color-mix(in_oklch,var(--color-green)_30%,transparent)]',
	warning: 'bg-[color-mix(in_oklch,var(--color-amber)_12%,var(--background))] text-[var(--color-amber)] border-[color-mix(in_oklch,var(--color-amber)_30%,transparent)]',
	info: 'bg-[color-mix(in_oklch,var(--color-cyan)_12%,var(--background))] text-[var(--color-cyan)] border-[color-mix(in_oklch,var(--color-cyan)_30%,transparent)]',
};

const iconSVGs = {
	default: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>`,
	destructive: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>`,
	success: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>`,
	warning: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>`,
	info: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>`,
};

const classes = `relative w-full rounded-[var(--radius)] border p-4 ${variants[variant]} ${className}`;
---

<div {...attrs} class={classes} role="alert">
	<div class="flex gap-3">
		<div class="flex-shrink-0" set:html={iconSVGs[variant]} />
		<div class="flex-1">
			{title && <h5 class="font-medium mb-1">{title}</h5>}
			<div class="text-sm"> <slot /> </div>
		</div>
	</div>
</div>